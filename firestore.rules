rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isSignedIn() && resource != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Dates may be a Firestore timestamp or a number for now.
    // Tighten to timestamp-only once the app format is final.
    function isTime(v) {
      return v is timestamp || v is number;
    }

    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function validUser(d) {
      return d.keys().hasOnly(
          ['ownerUid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'email', 'createdAt', 'updatedAt'])
        && d.email is string && d.email.size() > 0 && d.email.size() <= 256
        && optStr(d, 'displayName', 100)
        && isTime(d.createdAt) && isTime(d.updatedAt);
    }

    function validGoal(d) {
      return d.keys().hasOnly(
          ['ownerUid', 'title', 'description', 'status', 'targetDate',
           'constraints', 'preferredSchedule', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(
          ['ownerUid', 'title', 'status', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && optStr(d, 'description', 2000)
        && d.status in ['active', 'completed', 'archived']
        && optStr(d, 'preferredSchedule', 500)
        && optStr(d, 'targetDate', 64)
        && (!('constraints' in d)
            || (d.constraints is list && d.constraints.size() <= 20))
        && isTime(d.createdAt) && isTime(d.updatedAt);
    }

    function validTask(d) {
      return d.keys().hasOnly(
          ['ownerUid', 'goalId', 'planId', 'title', 'description', 'status',
           'priority', 'order', 'dueAt', 'estimatedDurationMinutes',
           'completedAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(
          ['ownerUid', 'goalId', 'title', 'status', 'priority', 'order',
           'createdAt', 'updatedAt'])
        && d.goalId is string && d.goalId.size() > 0 && d.goalId.size() <= 128
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && optStr(d, 'description', 2000)
        && optStr(d, 'planId', 128)
        && d.status in ['todo', 'in_progress', 'done', 'cancelled']
        && d.priority in ['low', 'medium', 'high']
        && d.order is int
        && (!('dueAt' in d) || isTime(d.dueAt))
        && (!('completedAt' in d) || isTime(d.completedAt))
        && (!('estimatedDurationMinutes' in d)
            || (d.estimatedDurationMinutes is int
                && d.estimatedDurationMinutes > 0
                && d.estimatedDurationMinutes <= 1440))
        && isTime(d.createdAt) && isTime(d.updatedAt);
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && validUser(request.resource.data);

      allow update: if isOwner(uid)
        && validUser(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ---------- goals/{goalId} ----------
    match /goals/{goalId} {
      allow read: if isDocOwner();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validGoal(request.resource.data);

      allow update: if isDocOwner()
        && validGoal(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;

      // Goals are archived (status = 'archived'), not deleted, so tasks
      // are never orphaned.
      allow delete: if false;
    }

    // ---------- tasks/{taskId} ----------
    match /tasks/{taskId} {
      allow read: if isDocOwner();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validTask(request.resource.data);

      allow update: if isDocOwner()
        && validTask(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.goalId == resource.data.goalId;

      // Tasks are cancelled via status, never deleted from the client
      allow delete: if false;
    }

    // ---------- Backend-only collections (Admin SDK bypasses rules) ----------
    match /plans/{planId} {
      allow read: if isDocOwner();
      allow write: if false;
    }

    match /agentActions/{actionId} {
      allow read: if isDocOwner();
      allow write: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isDocOwner();
      allow write: if false;
    }
  }
}