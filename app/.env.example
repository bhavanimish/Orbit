EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=orbit-pa
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Emulators configuration
# Set to true to connect to local Firebase emulators
EXPO_PUBLIC_USE_EMULATORS=false
# Android emulator uses 10.0.2.2; a physical phone needs this PC's LAN IP.
EXPO_PUBLIC_EMULATOR_HOST=localhost
