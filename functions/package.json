{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "mocha -r ts-node/register src/__tests__/planner.spec.ts src/__tests__/actions.spec.ts",
    "test:rules": "firebase emulators:exec --only firestore \"npx mocha -r ts-node/register src/__tests__/rules.spec.ts --timeout 30000\"",
    "emulators": "npm run build && firebase emulators:start --only functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  },
  "private": true
}